# =============================================================================
# ReplyCators — .gitignore
# Dependency Governance Policy: this repository is SOURCE-ONLY.
# Runtime tooling, local dependency installations, build artifacts, and caches
# must NEVER be committed.
# See AGENTS.md § Repository Hygiene Rules
#     AGENTS.md § Dependency Installation Policy
#     AGENTS.md § 13-A Runtime-First Policy
#
# AUTHORITATIVE NODE DEPENDENCY STORE: C:\Work\Bob\Runtime\NodeJS\node_modules
# DO NOT run "npm install" inside this repository as a routine step.
# Reuse Runtime tooling. See AGENTS.md § 13-A for the full decision tree.
# =============================================================================

# ── Node.js dependencies ──────────────────────────────────────────────────────
# NEVER commit node_modules.
# RUNTIME-FIRST: Check C:\Work\Bob\Runtime\NodeJS before any local install.
# Authoritative dependency store: C:\Work\Bob\Runtime\NodeJS\node_modules
# Local node_modules/ is the EXCEPTION path — delete immediately after use.
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Package manager caches / lock files generated by local installs ───────────
.npm/
.yarn/
.yarnrc.yml
.pnp.*
npm-cache/
pnpm-store/
.pnpm-store/
yarn-cache/
.yarn-integrity

# ── Build output ──────────────────────────────────────────────────────────────
# dist/ holds the webpack-compiled output of src/.
# It is intentionally kept in version control so the extension can be loaded
# directly from the repository without a build step on first checkout.
# Remove the comment below (# dist/) and uncomment to exclude if CI builds it.
# dist/

# build/ contains build *scripts* (gen_icons.js, webpack.config.js, package.js)
# and must be kept.  The line below is intentionally absent.

# Temporary / intermediate build artefacts
*.crx
*.zip
*.pem
*.key

# ── Coverage & test output (if testing infrastructure is ever reintroduced) ───
coverage/
.nyc_output/
test-results/
*.lcov

# ── Temporary directories ─────────────────────────────────────────────────────
temp/
.tmp/
tmp/
.cache/
cache/

# ── IDE / editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.user
*.swp
*.swo
*~

# ── OS artefacts ──────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Runtime distributions — must NOT be copied into the repository ────────────
# Shared runtimes belong at: C:\Work\Bob\Runtime
# See AGENTS.md § Dependency Installation Policy for the approval procedure.
NodeJS/
node/
.node_repl_history
Python/
python/
dotnet/
/sdk/
/SDK/

# ── Bob agent workspace ───────────────────────────────────────────────────────
# .bob/ is created by the Bob agent and should not be committed.
.bob/
# Also covers any .bob/ directories that appear inside subdirectories
# (e.g. native-host/.bob/ created when Bob runs with a subdirectory as cwd).
**/.bob/

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/
*.log