{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://replycators.example/schemas/governance-finding-1.0.json",
  "title": "ReplyCators Governance Finding Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "repository_sha",
    "prompt_id",
    "prompt_version",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "repository_sha": {
      "type": "string",
      "minLength": 1
    },
    "prompt_id": {
      "type": "string",
      "minLength": 1
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "maxItems": 15,
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "source",
        "severity",
        "confidence",
        "component",
        "summary",
        "description",
        "evidence",
        "root_cause",
        "recommended_action",
        "acceptance_criteria",
        "validation_plan",
        "regression_areas",
        "dependencies",
        "release_impact"
      ],
      "properties": {
        "finding_id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "enum": [
            "architecture",
            "security",
            "performance",
            "qa",
            "documentation",
            "release"
          ]
        },
        "severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ]
        },
        "confidence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "component": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "root_cause": {
          "type": "string",
          "minLength": 1
        },
        "recommended_action": {
          "type": "string",
          "minLength": 1
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "validation_plan": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "regression_areas": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "release_impact": {
          "enum": [
            "blocker",
            "high",
            "medium",
            "low",
            "none"
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "observation"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "observation": {
          "type": "string",
          "minLength": 15
        }
      }
    }
  }
}
