{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "baseUrl": "./src",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "exactOptionalPropertyTypes": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["chrome"],
    "paths": {
      "@replycators/sdk":         ["sdk/index.ts"],
      "@replycators/sdk/*":       ["sdk/*"],
      "@replycators/core/*":      ["core/*"],
      "@replycators/platform/*":  ["platform/*"],
      "./sdk":                    ["sdk/index.ts"],
      "./sdk/*":                  ["sdk/*"],
      "./platform/*":             ["platform/*"],
      "./core/*":                 ["core/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "build"]
}
